{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KidMusic v1 page (manifest count, unique IDs, byte length and SHA/path equality also required)",
  "type": "object",
  "required": ["schema_version", "release_id", "page", "total_pages", "tracks"],
  "properties": {
    "schema_version": {"const": 1},
    "release_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,47}$"},
    "page": {"type": "integer", "minimum": 0, "maximum": 49},
    "total_pages": {"type": "integer", "minimum": 1, "maximum": 50},
    "tracks": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["id", "title", "size_bytes", "sha256", "audio_path"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,39}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 95, "description": "At most 95 UTF-8 bytes, valid Unicode and no control characters; firmware font coverage checked separately"},
          "size_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "audio_path": {"type": "string", "pattern": "^/v1/audio/[0-9a-f]{64}\\.opus$"},
          "duration_ms": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
