# Run ONLY with sdkconfig.defaults + sdkconfig.test.defaults (Wi-Fi disabled).
# Existing migrated five-song cache. No writes/removals or account changes.
sleep 3
send s
expect --timeout 10 TEST page=0.*local=5
send d
send o
